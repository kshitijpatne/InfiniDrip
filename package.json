{
  "name": "InfiniDrip",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "web:manifest": "node ops/web/create-artifact-manifest.mjs dist ops/web/artifact-manifest.json",
    "web:serve": "vite preview --host 127.0.0.1 --port 4173",
    "control-center:serve": "node ops/control-center/server.mjs",
    "control-center:command": "node ops/control-center/cli.mjs",
    "control-center:test": "node --test ops/control-center/app/board.test.mjs ops/control-center/commands.test.mjs ops/control-center/board-store.test.mjs ops/control-center/import-facts.test.mjs ops/control-center/server.test.mjs",
    "web:proof:test": "node --test ops/web/create-artifact-manifest.test.mjs",
    "web:release:test": "node --test ops/web/create-artifact-manifest.test.mjs ops/web/release-rehearsal.test.mjs",
    "web:verify-artwork-store": "node ops/web/verify-browser-artwork-store.mjs",
    "readiness:drill:test": "node --test ops/readiness/readiness-drill.test.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "electron:build-main": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:build-main && electron .",
    "electron:pack": "npm run build && npm run electron:build-main && electron-builder --dir --publish never",
    "electron:verify-idb-file-origin": "node electron/verify-idb-file-origin.cjs",
    "electron:verify-project-repository": "node electron/verify-project-repository.cjs",
    "preelectron:verify-project-workflow": "npm run build && npm run electron:build-main",
    "electron:verify-project-workflow": "node electron/verify-project-workflow.cjs",
    "electron:verify": "node electron/verify-save.cjs",
    "electron:verify-artwork-store": "node electron/verify-artwork-store.cjs",
    "electron:verify-packaged": "node electron/verify-save.cjs --packaged",
    "electron:verify-menu": "node electron/verify-menu-and-window.cjs",
    "electron:verify-menu-packaged": "node electron/verify-menu-and-window.cjs --packaged",
    "electron:verify-release": "node electron/verify-release.cjs --packaged"
  },
  "devDependencies": {
    "@flatten-js/core": "^1.6.14",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^2.1.8",
    "axe-core": "^4.13.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "6.2.5",
    "fast-check": "^4.10.2",
    "jsdom": "^25.0.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.infinidrip.app",
    "productName": "InfiniDrip",
    "files": ["dist/**/*", "dist-electron/**/*"],
    "directories": { "output": "release" },
    "mac": { "target": "dir", "identity": null },
    "win": { "target": "dir" },
    "linux": { "target": "dir", "executableName": "InfiniDrip" }
  }
}
