import { GARMENTS, STANDARD_M, defaultGarmentOptions } from '../../../../src/drafting';
import { compileTechnicalFlatLiveView } from '../../../../src/render/technical-flat-live';
import type { FlatPathCommand, FlatPoint, TechnicalFlatPrimitive } from '../../../../src/render/technical-flat';
const fmt=(v:number)=>Number(v.toFixed(4)).toString();const key=(p:FlatPoint)=>`${fmt(p.x)},${fmt(p.y)}`;
type E={from:FlatPoint;to:FlatPoint;ownerId:string;sourceEdgeId?:string};
function sourceEdges(commands:readonly FlatPathCommand[],ownerId:string,ids?:readonly string[]):E[]{let start:FlatPoint|null=null,current:FlatPoint|null=null,has=false,index=-1,source:string|undefined;const es:E[]=[];for(const c of commands){if(c.op==='move'){index++;source=ids?.[index];start=c.point;current=c.point;has=false}else if(c.op==='line'){es.push({from:current!,to:c.point,ownerId,sourceEdgeId:source});current=c.point;has=true}else if(c.op==='cubic'){es.push({from:current!,to:c.point,ownerId,sourceEdgeId:source});current=c.point;has=true}else if(start&&current&&has){es.push({from:current,to:start,ownerId,sourceEdgeId:source});start=null;current=null}else return []}return es}
function cancel(edges:E[]):E[]{const suf=':attached-fold-reflection';const k=(e:E)=>{const root=e.ownerId.endsWith(suf)?e.ownerId.slice(0,-suf.length):e.ownerId;const p=[key(e.from),key(e.to)].sort();return `${root}\0${e.sourceEdgeId??''}\0${p[0]}\0${p[1]}`};const gs=new Map<string,{base:E[],ref:E[]}>();for(const e of edges){const id=k(e),v=gs.get(id)??{base:[],ref:[]};v[e.ownerId.endsWith(suf)?'ref':'base'].push(e);gs.set(id,v)}return [...gs.values()].flatMap(v=>v.base.length===1&&v.ref.length===1?[]:[...v.base,...v.ref])}
function roleFor(p:TechnicalFlatPrimitive){const m=/^pattern:[^:]+:role:([^:]+)(?::edge:[^:]+)?$/u.exec(p.source.sourceId);if(m)return m[1]!;const b=/^view:[^:]+:role:([^:]+):/u.exec(p.source.sourceId);return b?.[1]??null}
const recipe=GARMENTS.find(x=>x.name==='woven-shirt')!;const block=recipe.draft(STANDARD_M,defaultGarmentOptions(recipe.options??[]));
for(const kind of ['FRONT_FLAT','BACK_FLAT'] as const){const {view,colorway}=compileTechnicalFlatLiveView({recipe,block,revisionId:'live-draft:woven-shirt:14:14',kind,placements:[],colorHex:'#334455',texture:'woven',shine:.15});console.log('\n',kind);for(const role of ['outerStand','upperCollar','underCollar']){const ps=view!.primitives.filter((p):p is Extract<TechnicalFlatPrimitive,{kind:'path'}>=>p.kind==='path'&&p.layer==='GARMENT_SILHOUETTE'&&roleFor(p)===role);const es=ps.flatMap(p=>sourceEdges(p.commands,p.id,p.sourceEdgeIds));const excl=new Set<string>();for(const p of ps){if(!p.sourceEdgeIds)continue;const rf=ps.find(q=>q.id===`${p.id}:attached-fold-reflection`&&q.source.sourceId===p.source.sourceId&&q.source.revisionId===p.source.revisionId);if(rf?.sourceEdgeIds)for(const id of p.sourceEdgeIds)if(!rf.sourceEdgeIds.includes(id))excl.add(`${p.id}\0${id}`)}const filtered=es.filter(e=>!e.sourceEdgeId||!excl.has(`${e.ownerId}\0${e.sourceEdgeId}`));const chosen=cancel(filtered);const adj=new Map<string,number[]>();chosen.forEach((e,i)=>{for(const p of [e.from,e.to])adj.set(key(p),[...(adj.get(key(p))??[]),i])});const bad=[...adj].filter(([,is])=>is.length!==2);if(kind==='FRONT_FLAT'&&role==='upperCollar')console.log('TIPEDGES',es.filter(e=>e.sourceEdgeId?.endsWith(':edge:frontTip')).map(e=>[e.ownerId,e.sourceEdgeId,key(e.from),key(e.to)]).slice(0,6));console.log(role,{paths:ps.length,edges:es.length,chosen:chosen.length,degrees:[...new Set([...adj.values()].map(x=>x.length))],bad:bad.slice(0,10).map(([p,is])=>[p,is.length,is.map(i=>{const e=chosen[i]!;return [e.ownerId.split(':').slice(-2).join(':'),e.sourceEdgeId?.split(':').at(-1),key(e.from),key(e.to)]})])});}}
