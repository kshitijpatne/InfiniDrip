{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinidrip.local/schemas/control-center/work-item.v1.json",
  "title": "InfiniDrip Control Center work item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "epicId",
    "releaseId",
    "status",
    "openedAt",
    "targetAt",
    "deliveredAt",
    "priority",
    "risk",
    "owner",
    "contributor",
    "reviewer",
    "dependencies",
    "protectedSurfaces",
    "description",
    "expectation",
    "acceptanceCriteria",
    "statusHistory",
    "comments",
    "evidenceRefs",
    "flagKey"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,80}$" },
    "type": { "enum": ["epic", "slice", "task", "bug", "research"] },
    "title": { "type": "string", "minLength": 1 },
    "epicId": { "type": ["string", "null"] },
    "releaseId": { "type": ["string", "null"] },
    "status": {
      "enum": ["Draft", "Backlog", "Ready", "In Progress", "In Review", "Accepted", "Closed", "Blocked", "Reopened"]
    },
    "openedAt": { "type": ["string", "null"], "format": "date" },
    "targetAt": { "type": ["string", "null"], "format": "date" },
    "deliveredAt": { "type": ["string", "null"], "format": "date" },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "owner": { "type": "string", "minLength": 1 },
    "contributor": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "protectedSurfaces": { "type": "array", "items": { "type": "string" } },
    "description": { "type": "string", "minLength": 1 },
    "expectation": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "statusHistory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "at", "actor", "note"],
        "properties": {
          "status": { "$ref": "#/$defs/status" },
          "at": { "type": "string", "format": "date-time" },
          "actor": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "actor", "text"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "actor": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "flagKey": { "type": ["string", "null"] }
  },
  "$defs": {
    "status": {
      "enum": ["Draft", "Backlog", "Ready", "In Progress", "In Review", "Accepted", "Closed", "Blocked", "Reopened"]
    }
  }
}
